# ── Symfony ───────────────────────────────────────────────────────────────── #
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_me_to_a_32char_random_string

# ── MySQL ──────────────────────────────────────────────────────────────────── #
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=symfony_db
MYSQL_USER=symfony
MYSQL_PASSWORD=symfony_password

# Symfony DATABASE_URL (auto-built in docker-compose, keep in sync if used outside)
DATABASE_URL="mysql://symfony:symfony_password@db:3306/symfony_db?serverVersion=8.0&charset=utf8mb4"

DEFAULT_URI="http://localhost"

MESSENGER_TRANSPORT_DSN=doctrine://default
