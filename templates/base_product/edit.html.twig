{% extends 'base.html.twig' %}

{% block title %}Edit Base Product{% endblock %}

{% block page_header %}
    <div class="breadcrumbs text-sm py-0">
        <ul>
            <li><a href="{{ path('app_base_product_index') }}">Base Products</a></li>
            <li><a href="{{ path('app_base_product_show', {id: base_product.id}) }}">{{ base_product.name }}</a></li>
            <li class="text-base-content/70">Edit</li>
        </ul>
    </div>
{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 flex flex-col gap-5">

        {# ── FORM CARD ── #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-8 gap-6">

                {# Card header #}
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 pb-4 border-b border-base-300">
                    <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center shrink-0">
                        <twig:ux:icon name="lucide:pencil" class="h-5 w-5 text-warning"/>
                    </div>
                    <div>
                        <h1 class="font-display text-lg sm:text-xl text-base-content leading-tight">Edit base product</h1>
                        <p class="text-xs text-base-content/50 mt-0.5">Update the details of the base product below.</p>
                    </div>
                </div>

                {{ include('base_product/_form.html.twig', {form: form}) }}
            </div>
        </div>

    </div>
{% endblock %}
