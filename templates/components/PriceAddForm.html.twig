<div{{ attributes }}>
    {# ── Modal toggle (hidden checkbox — DaisyUI pattern) ── #}
    <input type="checkbox" id="price-modal" class="modal-toggle" {{ open_modal ?? false ? 'checked' : '' }} />

    {# ── Modal overlay + dialog ── #}
    <div class="modal modal-bottom sm:modal-middle" role="dialog" aria-labelledby="price-modal-title">

        <div class="modal-box w-full max-w-md p-0 overflow-visible">

            {# ── Modal header ── #}
            <div class="flex items-center gap-3 px-6 pt-6 pb-4 border-b border-base-300">
                <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <h2 id="price-modal-title" class="font-display text-lg text-base-content leading-tight">
                        New product
                    </h2>
                    <p class="text-xs text-base-content/50 mt-0.5">Add a new item to the grocery catalogue.</p>
                </div>
                {# Close ✕ button #}
                <label for="price-modal"
                       class="btn btn-ghost btn-square btn-sm -mr-1 -mt-1 self-start"
                       aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </label>
            </div>


            <input
                type="number"
                data-model="price"
            >

            <div>{{ grocery.name|default("NO NAME") }}</div>

            {# ── Modal actions ── #}
            <div class="flex justify-end gap-2 pt-2 border-t border-base-300">
                <label for="price-modal" class="btn btn-ghost btn-sm">
                    Cancel
                </label>
                <button data-action="live#action" data-live-action-param="save" class="btn btn-primary btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add price
                </button>
            </div>

        </div>

        {# Click-outside overlay closes the modal #}
        <label class="modal-backdrop" for="price-modal" aria-label="Close modal"></label>
    </div>
</div>
