<div{{ attributes }}>
    {{ form_start(form, { attr: { class: 'flex flex-col gap-5', novalidate: 'novalidate' } }) }}

    {# ── Price value ── #}
    <div class="flex flex-col gap-1.5">
        {{ form_label(form.value, 'Price value', {
            label_attr: { class: 'text-sm font-medium text-base-content' }
        }) }}

        <label class="input input-bordered flex items-center gap-2
                      {{ form.value.vars.errors|length > 0 ? 'input-error' : '' }}">
            <span class="text-base-content/40 font-semibold text-sm shrink-0">€</span>
            {{ form_widget(form.value, {
                attr: {
                    class:        'grow bg-transparent outline-none text-sm font-mono',
                    placeholder:  '0.00',
                    step:         '0.01',
                    min:          '0',
                    autocomplete: 'off'
                }
            }) }}
        </label>

        {% if form.value.vars.errors|length > 0 %}
            <div class="flex items-start gap-1.5 text-error text-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span>{{ form_errors(form.value) }}</span>
            </div>
        {% else %}
            <p class="text-xs text-base-content/40">Enter the price in euros, e.g. 1.49</p>
        {% endif %}
    </div>

    {# ── Store / shop ── #}
    <div class="flex flex-col gap-1.5">
        {{ form_label(form.shop, 'Store / shop', {
            label_attr: { class: 'text-sm font-medium text-base-content' }
        }) }}

        <label class="input input-bordered flex items-center gap-2
                      {{ form.shop.vars.errors|length > 0 ? 'input-error' : '' }}">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-40 shrink-0"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            {{ form_widget(form.shop, {
                attr: {
                    class:        'grow bg-transparent outline-none text-sm',
                    placeholder:  'e.g. Continente, Pingo Doce, Lidl…',
                    autocomplete: 'off',
                    list:         'store-suggestions'
                }
            }) }}
        </label>

        <datalist id="store-suggestions">
            <option value="Continente">
            <option value="Pingo Doce">
            <option value="Lidl">
            <option value="Aldi">
            <option value="Minipreço">
            <option value="Intermarché">
            <option value="El Corte Inglés">
        </datalist>

        {% if form.shop.vars.errors|length > 0 %}
            <div class="flex items-start gap-1.5 text-error text-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span>{{ form_errors(form.shop) }}</span>
            </div>
        {% else %}
            <p class="text-xs text-base-content/40">Name of the store where you found this price.</p>
        {% endif %}
    </div>

    {# ── Product (Tom Select) ── #}
    <div class="flex flex-col gap-1.5">
        {{ form_label(form.grocery, 'Product', {
            label_attr: { class: 'text-sm font-medium text-base-content' }
        }) }}

        {{ form_widget(form.grocery) }}

        {% if form.grocery.vars.errors|length > 0 %}
            <div class="flex items-start gap-1.5 text-error text-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span>{{ form_errors(form.grocery) }}</span>
            </div>
        {% else %}
            <p class="text-xs text-base-content/40">Search and select the product.</p>
        {% endif %}
    </div>

    {% if form.groceryUnit is defined %}
        {# ── Product Unit (Read-only) ── #}
        <div class="flex flex-col gap-1.5">
            {{ form_label(form.groceryUnit, 'Unidade do Produto', {
                label_attr: { class: 'text-sm font-medium text-base-content' }
            }) }}

            <label class="input input-bordered flex items-center gap-2 bg-base-200">
                {{ form_widget(form.groceryUnit, {
                    attr: {
                        class: 'grow bg-transparent outline-none text-sm',
                        readonly: 'readonly'
                    }
                }) }}
            </label>
        </div>
    {% endif %}

    <div class="flex flex-row gap-4">
        {% if form.amount is defined %}
            {# ── Amount ── #}
            <div class="flex flex-col gap-1.5 flex-1">
                {{ form_label(form.amount, 'Quantidade', {
                    label_attr: { class: 'text-sm font-medium text-base-content' }
                }) }}

                <label class="input input-bordered flex items-center gap-2">
                    {{ form_widget(form.amount, {
                        attr: {
                            class:        'grow bg-transparent outline-none text-sm font-mono',
                            placeholder:  '0',
                            step:         '0.01',
                            min:          '0',
                            autocomplete: 'off'
                        }
                    }) }}
                </label>
            </div>
        {% endif %}

        {% if form.unitType is defined %}
            {# ── Unit Type ── #}
            <div class="flex flex-col gap-1.5 flex-1">
                {{ form_label(form.unitType, 'Unidade', {
                    label_attr: { class: 'text-sm font-medium text-base-content' }
                }) }}

                {{ form_widget(form.unitType, {
                    attr: {
                        class: 'select select-bordered w-full text-sm'
                    }
                }) }}
            </div>
        {% endif %}
    </div>

    <div class="divider">Calculated Details</div>

    {# ── Quantity ── #}
    <div class="flex flex-col gap-1.5">
        {{ form_label(form.quantity, 'Quantidade Base', {
            label_attr: { class: 'text-sm font-medium text-base-content' }
        }) }}

        <label class="input input-bordered flex items-center gap-2
                      {{ form.quantity.vars.errors|length > 0 ? 'input-error' : '' }}">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-40 shrink-0"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
            </svg>
            {{ form_widget(form.quantity, {
                attr: {
                    class:        'grow bg-transparent outline-none text-sm font-mono',
                    placeholder:  '0',
                    step:         '0.01',
                    min:          '0',
                    autocomplete: 'off'
                }
            }) }}
        </label>

        {% if form.quantity.vars.errors|length > 0 %}
            <div class="flex items-start gap-1.5 text-error text-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span>{{ form_errors(form.quantity) }}</span>
            </div>
        {% else %}
            <p class="text-xs text-base-content/40">A quantidade, na unidade selecionada, do produto</p>
        {% endif %}
    </div>

    {# ── Unit (subUnit) ── #}
    <div class="flex flex-col gap-1.5">
        {{ form_label(form.subUnit, 'Unidade Base', {
            label_attr: { class: 'text-sm font-medium text-base-content' }
        }) }}

        {{ form_widget(form.subUnit, {
            attr: {
                class: 'select select-bordered w-full text-sm'
                ~ (form.subUnit.vars.errors|length > 0 ? ' select-error' : '')
            }
        }) }}

        {% if form.subUnit.vars.errors|length > 0 %}
            <div class="flex items-start gap-1.5 text-error text-xs">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                <span>{{ form_errors(form.subUnit) }}</span>
            </div>
        {% else %}
            <p class="text-xs text-base-content/40">Selecione a unidade da quantidade a introduzir.</p>
        {% endif %}
    </div>

    {# ── Global form errors ── #}
    {% if form.vars.errors|length > 0 %}
        <div role="alert" class="alert alert-error alert-soft py-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div class="text-sm">{{ form_errors(form) }}</div>
        </div>
    {% endif %}

    {# ── Timestamp note ── #}
    <div class="flex items-center gap-2 text-xs text-base-content/40 bg-base-200 rounded-lg px-3 py-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Recorded at <strong class="font-medium text-base-content/60 ml-0.5">{{ "now"|date("d M Y") }}</strong>
    </div>

    {# ── Actions ── #}
    <div class="flex justify-end gap-2 pt-2 border-t border-base-300">
        <button type="submit" class="btn btn-primary btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Record price
        </button>
    </div>

    {{ form_rest(form) }}
    {{ form_end(form) }}
</div>
