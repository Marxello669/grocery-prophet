<div{{ attributes }}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col gap-6">

        <section class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-5 flex flex-col gap-4">
                <div class="flex flex-col sm:flex-row gap-3">

                    {# Name search #}
                    <label class="input input-bordered flex items-center gap-2 flex-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-40 shrink-0" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                        </svg>
                        <input
                            data-model="query"
                            type="text"
                            placeholder="Search by name…"
                            class="grow text-sm"
                            autocomplete="off"
                        />
                    </label>

                    {# Type select #}
                    <select data-model="type" class="select select-bordered w-full sm:w-52 text-sm">
                        <option value="">All types</option>
                        {% for type in this.types %}
                            <option value="{{ type.value }}">{{ type.label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </section>

        {% if this.query is not empty or this.type is not null %}
            <div id="active-filters" class="flex-wrap gap-2 items-center text-sm text-base-content/60">
                <span class="font-medium">Active filters:</span>
                {% if this.query is not empty %}
                    <span id="af-name" class="badge badge-primary badge-soft">{{ this.query }}</span>
                {% endif %}

                {% if this.type is not null %}
                    <span id="af-type" class="badge badge-secondary badge-soft">{{ this.type.label }}</span>
                {% endif %}
            </div>
        {% endif %}

        <section class="card bg-base-100 shadow-sm overflow-hidden">
            {# Table header #}
            <div class="hidden sm:grid grid-cols-[2.5rem_1fr_6rem_6rem_9rem_2rem] gap-x-4 items-center
                  px-5 py-3 border-b border-base-300 text-xs font-semibold uppercase tracking-wider
                  text-base-content/40 select-none">
                <span></span>
                <span>Product</span>
                <span>Type</span>
                <span class="text-right">Price</span>
                <span>Shop</span>
                <span class="text-right"></span>
            </div>

            <ul class="w-full flex flex-col" data-loading="hide">
                {% for entry in this.entries %}
                    {{ include('index/_table_line.twig', {
                        entry: entry,
                        lowestPrice: this.getLowestPrice(entry)
                    }) }}
                {% endfor %}
            </ul>

            {# Skeleton #}
            <ul class="w-full flex flex-col" data-loading="show">
                {% for i in 1..5 %}
                    <li class="grid grid-cols-[2.5rem_1fr_6rem_6rem_9rem_2rem] gap-x-4 items-center px-5 py-4 border-b border-base-200/50">
                        <div class="skeleton h-6 w-6 rounded-full"></div> {# Icon/Checkbox #}
                        <div class="flex flex-col gap-2">
                            <div class="skeleton h-4 w-32"></div> {# Title #}
                            <div class="skeleton h-3 w-20 opacity-50"></div> {# Subtitle #}
                        </div>
                        <div class="skeleton h-4 w-20"></div> {# Type #}
                        <div class="skeleton h-4 w-16 justify-self-end"></div> {# Price #}
                        <div class="skeleton h-4 w-16 justify-self-end"></div> {# Shop #}
                        <div class="skeleton h-6 w-1 rounded-full justify-self-end"></div> {# Actions #}
                    </li>
                {% endfor %}
            </ul>

            {# Empty state #}
            <div id="empty-state" class="hidden flex-col items-center justify-center py-20 text-center gap-3">
                <span class="text-5xl">🔍</span>
                <p class="font-display text-xl text-base-content/60">No products found</p>
                <p class="text-sm text-base-content/40">Try adjusting your filters</p>
                <button id="empty-reset" class="btn btn-ghost btn-sm mt-2">↺ Clear filters</button>
            </div>

            {# List footer with count #}
            <div id="list-footer"
                 class="px-5 py-3 flex items-center justify-between text-xs text-base-content/40 border-t border-base-200">
                <span id="footer-count">{{ this.entries.count }} products</span>


                <div class="join">
                    {# Previous Button calling previousPage() #}
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="previousPage"
                        class="join-item btn btn-sm {{ this.page <= 1 ? 'btn-disabled' : '' }}"
                    >
                        <
                    </button>

                    {# Example of jumping to a specific page using a parameter #}
                    {% if this.page > 2 %}
                        <button
                            type="button"
                            data-action="live#action"
                            data-live-action-param="setPage"
                            data-live-page-param="1"
                            class="join-item btn btn-sm"
                        >1
                        </button>
                        <button class="join-item btn btn-sm btn-disabled">...</button>
                    {% endif %}

                    <button class="join-item btn btn-sm">{{ this.page }}</button>

                    {# Next Button calling nextPage() #}
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="nextPage"
                        class="join-item btn btn-sm {{ this.page >= this.totalPages ? 'btn-disabled' : '' }}"
                    >
                        >
                    </button>
                </div>

            </div>
        </section>

        <div class="flex flex-row justify-end">
            {# Trigger — opens the grocery modal #}
            <label for="grocery-modal" class="btn btn-primary btn-sm cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
                <span class="hidden sm:inline">Add product</span>
            </label>
        </div>
    </div>
</div>
