<div{{ attributes }}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col gap-6">

        <section class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-5 flex flex-col gap-4">
                <div class="flex flex-col sm:flex-row gap-3">

                    {# Name search #}
                    <label class="input input-bordered flex items-center gap-2 w-full sm:flex-1 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-40 shrink-0" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                        </svg>
                        <input
                            data-model="query"
                            type="text"
                            placeholder="Search by product name…"
                            class="grow bg-transparent border-0 focus:outline-0 focus:ring-0"
                            autocomplete="off"
                        />
                    </label>

                    {# Shop select #}
                    <select data-model="shop" class="select select-bordered w-full sm:w-52 text-sm">
                        <option value="">All shops</option>
                        {% for shop in this.shops %}
                            <option value="{{ shop.value }}">{{ shop.label }}</option>
                        {% endfor %}
                    </select>

                    {# Date filters #}
                    <div class="flex items-center gap-2">
                        <input
                            data-model="startDate"
                            type="date"
                            class="input input-bordered text-sm w-full sm:w-auto"
                            placeholder="From date"
                        />
                        <span class="text-base-content/40 hidden sm:inline">—</span>
                        <input
                            data-model="endDate"
                            type="date"
                            class="input input-bordered text-sm w-full sm:w-auto"
                            placeholder="To date"
                        />
                    </div>
                </div>
            </div>
        </section>

        {% if this.query is not empty or this.shop is not null or this.startDate is not empty or this.endDate is not empty %}
            <div id="active-filters" class="flex flex-wrap gap-2 items-center text-sm text-base-content/60">
                <span class="font-medium">Active filters:</span>
                {% if this.query is not empty %}
                    <span id="af-name" class="badge badge-primary badge-soft">{{ this.query }}</span>
                {% endif %}

                {% if this.shop is not null %}
                    <span id="af-shop" class="badge badge-secondary badge-soft">{{ this.shop.label }}</span>
                {% endif %}

                {% if this.startDate is not empty %}
                    <span id="af-start"
                          class="badge badge-accent badge-soft">From: {{ this.startDate|date('d/m/Y') }}</span>
                {% endif %}

                {% if this.endDate is not empty %}
                    <span id="af-end" class="badge badge-accent badge-soft">To: {{ this.endDate|date('d/m/Y') }}</span>
                {% endif %}

                <button
                    type="button"
                    data-action="live#action"
                    data-live-action-param="clearFilters"
                    class="btn btn-ghost btn-xs gap-1 ml-auto text-error hover:bg-error/10"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    Clear all
                </button>
            </div>
        {% endif %}

        <section class="card bg-base-100 shadow-sm overflow-hidden">
            {# Table header #}
            <div class="hidden md:grid grid-cols-[2.5rem_1fr_9rem_6rem_9rem_2.5rem] gap-x-4 items-center
                  px-5 py-3 border-b border-base-300 text-xs font-semibold uppercase tracking-wider
                  text-base-content/40 select-none">
                <span></span>
                <span>Product</span>
                <span>Shop</span>
                <span class="text-right">Price</span>
                <span>Date</span>
                <span class="text-right"></span>
            </div>

            <ul class="w-full flex flex-col" data-loading="hide">
                {% for entry in this.entries %}
                    <li class="product-card">
                        <div class="grid grid-cols-1 md:grid-cols-[2.5rem_1fr_9rem_6rem_9rem_2.5rem] gap-3 md:gap-x-4 md:items-center
                                          px-4 py-4 md:px-5 md:py-3.5 border-b border-base-200 group cursor-default">

                            <div class="flex items-center gap-3 md:contents">
                                {# Emoji #}
                                <div
                                    class="w-10 h-10 md:w-auto md:h-auto rounded-lg bg-base-200 flex items-center justify-center md:bg-transparent">
                                    <span class="text-2xl leading-none select-none"
                                          aria-hidden="true">{{ entry.grocery.type.emoji }}</span>
                                </div>

                                {# Name #}
                                <div class="flex-1 min-w-0">
                                    <a href="{{ path('app_grocery_show', {id: entry.grocery.id}) }}"
                                       class="hover:underline text-sm font-semibold text-base-content leading-tight block md:truncate">
                                        {{ entry.grocery.name }}
                                    </a>
                                    {# Mobile only: Shop badge #}
                                    <div class="md:hidden mt-0.5">
                                        <span class="badge badge-ghost badge-xs">{{ entry.shop.label }}</span>
                                    </div>
                                </div>

                                {# Mobile only: Edit button #}
                                <div class="md:hidden">
                                    <a href="{{ path('app_price_edit', {id: entry.id}) }}"
                                       class="btn btn-ghost btn-sm btn-circle">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>

                            {# Desktop Shop #}
                            <div class="hidden md:block">
                                <span class="badge badge-ghost badge-sm">{{ entry.shop.label }}</span>
                            </div>

                            {# Price #}
                            <div class="flex justify-between items-center md:justify-end md:text-right md:whitespace-nowrap">
                                <span
                                    class="md:hidden text-xs text-base-content/40 font-medium uppercase tracking-wider">Price</span>
                                <span class="font-display text-base font-bold text-primary md:truncate">
                                    {{ entry.value|number_format(2, ',', '.') }}€
                                    <span
                                        class="text-xs font-normal text-base-content/50">/ {{ entry.grocery.unit.label }}</span>
                                </span>
                            </div>

                            {# Date #}
                            <div class="flex justify-between items-center md:block md:whitespace-nowrap">
                                <span
                                    class="md:hidden text-xs text-base-content/40 font-medium uppercase tracking-wider">Date</span>
                                <span class="text-xs text-base-content/60 md:text-right md:w-full">
                                    {{ entry.createdAt|date('d/m/Y') }}
                                </span>
                            </div>

                            {# Desktop Action #}
                            <div class="hidden md:flex justify-end">
                                <a href="{{ path('app_price_edit', {id: entry.id}) }}"
                                   class="btn btn-ghost btn-sm btn-square">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>

            {# Skeleton #}
            <ul class="w-full flex flex-col" data-loading="show">
                {% for i in 1..5 %}
                    <li class="grid grid-cols-1 md:grid-cols-[2.5rem_1fr_9rem_6rem_9rem_2.5rem] gap-4 md:gap-x-4 items-center px-5 py-4 border-b border-base-200/50">
                        <div class="flex items-center gap-4">
                            <div class="skeleton h-10 w-10 md:h-6 md:w-6 rounded-full"></div> {# Emoji #}
                            <div class="flex flex-col gap-2 grow">
                                <div class="skeleton h-4 w-32 md:w-48"></div> {# Name #}
                                <div class="skeleton h-3 w-20 md:hidden"></div> {# Shop badge on mobile #}
                            </div>
                        </div>
                        <div class="hidden md:block skeleton h-4 w-20"></div> {# Shop #}
                        <div class="flex justify-between items-center md:justify-end gap-2">
                            <div class="md:hidden skeleton h-3 w-16"></div> {# Price label mobile #}
                            <div class="skeleton h-4 w-16"></div> {# Price #}
                        </div>
                        <div class="flex justify-between items-center md:block">
                            <div class="md:hidden skeleton h-3 w-16"></div> {# Date label mobile #}
                            <div class="skeleton h-4 w-24"></div> {# Date #}
                        </div>
                        <div class="hidden md:block skeleton h-6 w-1 rounded-full justify-self-end"></div> {# Actions #}
                    </li>
                {% endfor %}
            </ul>

            {# Empty state #}
            {% if this.entries.count == 0 %}
                <div id="empty-state" class="flex flex-col items-center justify-center py-20 text-center gap-3">
                    <span class="text-5xl">🔍</span>
                    <p class="font-display text-xl text-base-content/60">No prices found</p>
                    <p class="text-sm text-base-content/40">Try adjusting your filters</p>
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="clearFilters"
                        class="btn btn-ghost btn-sm mt-2"
                    >
                        ↺ Clear filters
                    </button>
                </div>
            {% endif %}

            {# List footer with count #}
            <div id="list-footer"
                 class="px-5 py-3 flex items-center justify-between text-xs text-base-content/40 border-t border-base-200">
                <span id="footer-count">{{ this.entries.count }} records</span>

                <div class="join">
                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="previousPage"
                        class="join-item btn btn-sm {{ this.page <= 1 ? 'btn-disabled' : '' }}"
                    >
                        <
                    </button>

                    <button class="join-item btn btn-sm">{{ this.page }}</button>

                    <button
                        type="button"
                        data-action="live#action"
                        data-live-action-param="nextPage"
                        class="join-item btn btn-sm {{ this.page >= this.totalPages ? 'btn-disabled' : '' }}"
                    >
                        >
                    </button>
                </div>
            </div>
        </section>

        <div class="flex flex-row justify-end">
            <a href="{{ path('app_price_new') }}" class="btn btn-primary btn-sm">
                <span class="inline">Record price</span>
            </a>
        </div>
    </div>
</div>
