{# templates/components/PriceChartComponent.html.twig #}
<div {{ attributes }} class="card bg-base-100 shadow-sm relative">
    <div class="card-body p-5 sm:p-6 gap-6">

        {# Header with Timeframe Picker #}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-lg font-bold text-base-content">Price History</h2>
                <p class="text-xs text-base-content/50">Tracking trends across all stores</p>
            </div>

            {# DaisyUI Tab Group for Switching #}
            <div class="tabs tabs-boxed bg-base-200 p-1">
                {% for label, value in {'1W': '1w', '1M': '1m', 'ALL': 'all'} %}
                    <button
                        type="button"
                        data-action="live#update"
                        data-live-update-param="timeFrame:{{ value }}"
                        class="tab tab-sm {{ this.timeFrame == value ? 'tab-active !bg-primary !text-primary-content' : '' }}"
                    >
                        {{ label }}
                    </button>
                {% endfor %}
            </div>
        </div>

        {# Chart Area #}
        <div class="relative w-full h-[300px]">
            {# The Real Chart #}
            <div data-loading="hide">
                {{ render_chart(this.chart) }}
            </div>

            {# Skeleton Loader for the Chart #}
            <div data-loading="show" class="absolute inset-0 flex flex-col gap-4">
                <div class="flex-1 flex items-end gap-2 px-2">
                    {% for i in 1..12 %}
                        <div class="skeleton w-full bg-base-300/50" style="height: {{ random(30, 90) }}%"></div>
                    {% endfor %}
                </div>
                <div class="flex justify-between px-2">
                    <div class="skeleton h-3 w-12"></div>
                    <div class="skeleton h-3 w-12"></div>
                    <div class="skeleton h-3 w-12"></div>
                </div>
            </div>
        </div>

        {# Footer Legend (Matches previous styles) #}
        <div class="flex flex-wrap gap-4 pt-4 border-t border-base-200">
            {% for ds in this.chart.data.datasets %}
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full" style="background-color: {{ ds.borderColor }}"></span>
                    <span class="text-xs font-medium text-base-content/70">{{ ds.label }}</span>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
