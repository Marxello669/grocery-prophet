{% extends 'base.html.twig' %}

{% block title %}{{ grocery.name }}{% endblock %}

{# ── Breadcrumb in the topbar ── #}
{% block page_header %}
    <div class="breadcrumbs text-sm py-0">
        <ul>
            <li><a href="{{ path('app_index') }}">Products</a></li>
            <li class="text-base-content/70">
                {{ grocery.name }}
            </li>
        </ul>
    </div>
{% endblock %}

{% block body %}
    {# Derived stats #}
    {% set lowestPrice  = currentPrices|filter(p => p.lowest)|first %}
    {% set highestPrice = currentPrices|filter(p => p.highest)|first %}
    {% set pricesCount = currentPrices|length %}
    {% set avgPrice = pricesCount > 0 ? (currentPrices|reduce((carry, p) => carry + p.price|number_format(2), 0) / pricesCount)|number_format(2) : 0 %}
    {% set spread = (highestPrice and lowestPrice) ? (highestPrice.price - lowestPrice.price)|number_format(2) : 0 %}

    <div class="min-h-screen bg-base-200">
        <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6 flex flex-col gap-5">
            {# ── HERO CARD ── #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-5 sm:p-6">
                    <div class="flex items-start gap-4">

                        {# Product icon #}
                        <div
                            class="w-14 h-14 rounded-xl bg-base-200 flex items-center justify-center text-3xl shrink-0 select-none">
                            {{ grocery.type.emoji }}
                        </div>

                        {# Name + meta #}
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-2 flex-wrap">
                                <div>
                                    <h1 class="font-display text-2xl text-base-content leading-tight">{{ grocery.name }}</h1>
                                    <p class="text-sm text-base-content/50 mt-0.5">
                                        <span
                                            class="badge badge-ghost badge-sm align-middle">{{ grocery.type.label }}</span>
                                    </p>
                                </div>
                            </div>

                            {# Lowest price highlight #}
                            <div class="flex items-baseline gap-2 mt-3">
                              <span class="font-display text-3xl font-bold text-primary">
                                {{ lowestPrice.price ?? '-' }}€
                              </span>

                                <span
                                    class="badge badge-ghost badge-sm align-middle">{{ lowestPrice.shop.label|default('No shop data') }}</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            {# ── STAT TILES ── #}
            <div class="grid grid-cols-3 gap-3">
                <div class="bg-base-100 rounded-xl p-4 shadow-sm">
                    <p class="text-xs text-base-content/50 uppercase tracking-wider font-medium">Shops</p>
                    <p class="text-2xl font-bold text-base-content mt-1">{{ currentPrices|length }}</p>
                </div>
                <div class="bg-base-100 rounded-xl p-4 shadow-sm">
                    <p class="text-xs text-base-content/50 uppercase tracking-wider font-medium">Avg. price</p>
                    <p class="text-2xl font-bold text-base-content mt-1">{{ avgPrice }}€</p>
                </div>
                <div class="bg-base-100 rounded-xl p-4 shadow-sm">
                    <p class="text-xs text-base-content/50 uppercase tracking-wider font-medium">Spread</p>
                    <p class="text-2xl font-bold text-base-content mt-1">{{ spread }}€</p>
                </div>
            </div>

            {# ── PRICE HISTORY CHART ── #}
            {% if currentPrices|length > 0 %}
                <twig:PriceChart :grocery="grocery"/>
            {% else %}
                <div class="card bg-base-100 shadow-sm p-10 text-center py-10">
                    <p class="text-base-content/50 italic">No price history available yet for this product.</p>
                </div>
            {% endif %}

            {# ── CURRENT PRICES TABLE ── #}
            <div class="card bg-base-100 shadow-sm overflow-hidden">
                <div class="card-body p-5 sm:p-6 pb-0 gap-0">
                    <h2 class="text-base font-semibold text-base-content mb-3">Current prices by shop</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="table table-sm">
                        <thead>
                        <tr>
                            <th>Shop</th>
                            <th class="text-right">Price</th>
                            <th class="text-right">vs. avg.</th>
                            <th class="text-right">Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entry in currentPrices %}
                            {% set diff = (entry.price - avgPrice)|number_format(2) %}
                            <tr class="hover:bg-base-200/50">
                                <td>
                                    <div class="flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full inline-block shrink-0"
                                              style="background-color: {{ entry.shop.color }};"></span>
                                        <span class="font-medium text-sm">{{ entry.shop.label }}</span>
                                    </div>
                                </td>
                                <td class="text-right font-display font-bold text-base text-primary">
                                    {{ entry.price|number_format(2) }}€
                                </td>
                                <td class="text-right text-sm">
                                    {% if diff > 0 %}
                                        <span class="text-error">+{{ diff }}€</span>
                                    {% elseif diff < 0 %}
                                        <span class="text-success">-{{ diff|abs }}€</span>
                                    {% else %}
                                        <span class="text-base-content/40">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-right">
                                    {% if entry.lowest %}
                                        <span class="badge badge-success badge-soft badge-sm">Lowest</span>
                                    {% elseif entry.highest %}
                                        <span class="badge badge-error badge-soft badge-sm">Highest</span>
                                    {% else %}
                                        <span class="badge badge-ghost badge-sm">Mid</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

{% endblock %}
