{% extends 'base.html.twig' %}

{% block title %}Add Product{% endblock %}

{# ── Breadcrumb in the topbar ── #}
{% block page_header %}
    <div class="breadcrumbs text-sm py-0">
        <ul>
            <li><a href="{{ path('app_index') }}">Products</a></li>
            <li class="text-base-content/70">New product</li>
        </ul>
    </div>
{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 flex flex-col gap-5">

        {# ── FORM CARD ── #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-5 sm:p-8 gap-6">

                {# Card header #}
                <div class="flex items-center gap-3 pb-4 border-b border-base-300">
                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="font-display text-xl text-base-content leading-tight">New product</h1>
                        <p class="text-xs text-base-content/50 mt-0.5">Fill in the details below to add a grocery item.</p>
                    </div>
                </div>

                {{ include('grocery/_form.html.twig', {form: form}) }}
            </div>
        </div>

    </div>
{% endblock %}
