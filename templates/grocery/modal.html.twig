<input type="checkbox" id="grocery-modal" class="modal-toggle" {{ open_modal ?? false ? 'checked' : '' }} />

<div class="modal modal-bottom sm:modal-middle" role="dialog" aria-labelledby="grocery-modal-title">
    <div class="modal-box w-full max-w-md p-0 overflow-visible">
        <div class="flex items-center gap-3 px-6 pt-6 pb-4 border-b border-base-300">
            <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <twig:ux:icon name="lucide:plus" class="h-5 w-5 text-primary"/>
            </div>
            <div class="flex-1 min-w-0">
                <h2 id="grocery-modal-title" class="font-display text-lg text-base-content leading-tight">
                    New product
                </h2>
                <p class="text-xs text-base-content/50 mt-0.5">Add a new item to the grocery catalogue.</p>
            </div>
            {# Close ✕ button #}
            <label for="grocery-modal"
                   class="btn btn-ghost btn-square btn-sm -mr-1 -mt-1 self-start"
                   aria-label="Close">
                <twig:ux:icon class="rotate-45" name="lucide:plus" />
            </label>
        </div>

        <div class="p-10">
            {{ include('grocery/_form.html.twig', {form: form}) }}
        </div>
    </div>

    <label class="modal-backdrop" for="grocery-modal" aria-label="Close modal"></label>
</div>
