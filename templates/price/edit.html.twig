{% extends 'base.html.twig' %}

{% block title %}Edit Price{% endblock %}

{# ── Breadcrumb in the topbar ── #}
{% block page_header %}
    <div class="breadcrumbs text-sm py-0">
        <ul>
            <li><a href="{{ path('app_index') }}">Products</a></li>
            {% if grocery is not null %}
                <li>
                    <a href="{{ path('app_grocery_show', { id: grocery.id }) }}">
                        {{ grocery.name }}
                    </a>
                </li>
            {% endif %}
            <li class="text-base-content/70">Edit price</li>
        </ul>
    </div>
{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 flex flex-col gap-5">

        {# ── CONTEXT CARD (shown when a product is pre-selected) ── #}
        {% if grocery is not null %}
            <a href="{{ path('app_grocery_show', { id: grocery.id }) }}"
               class="card bg-base-100 hover:bg-base-200 shadow-sm transition-colors">
                <div class="card-body p-4 flex flex-row items-center gap-4">
                    <div
                        class="w-11 h-11 rounded-xl bg-base-200 flex items-center justify-center text-2xl shrink-0 select-none">
                        {{ grocery.type.emoji }}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-base-content truncate">{{ grocery.name }}</p>
                        <p class="text-xs text-base-content/50 mt-0.5">
                            <span class="badge badge-ghost badge-xs align-middle">{{ grocery.type.label }}</span>
                        </p>
                    </div>

                    <twig:ux:icon name="lucide:chevron-right" class="h-4 w-4 text-base-content/30 shrink-0"/>
                </div>
            </a>
        {% endif %}

        {# ── FORM CARD ── #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-8 gap-6">

                {# Card header #}
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 pb-4 border-b border-base-300">
                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                        <twig:ux:icon name="lucide:pencil" class="h-5 w-5 text-primary"/>
                    </div>
                    <div>
                        <h1 class="font-display text-lg sm:text-xl text-base-content leading-tight">Edit price</h1>
                        <p class="text-xs text-base-content/50 mt-0.5">Modify the recorded price details.</p>
                    </div>
                </div>

                {# ── Symfony form ── #}
                {{ form_start(form, { attr: { class: 'flex flex-col gap-5', novalidate: 'novalidate' } }) }}

                {# ── Value / Price field ── #}
                <div class="flex flex-col gap-1.5">
                    {{ form_label(form.value, 'Price value', {
                        label_attr: { class: 'text-sm font-medium text-base-content' }
                    }) }}

                    <label class="input input-bordered flex items-center gap-2
                                  {{ form.value.vars.errors|length > 0 ? 'input-error' : '' }}">
                        <span class="text-base-content/40 font-semibold text-sm shrink-0">€</span>
                        {{ form_widget(form.value, {
                            attr: {
                                class:        'grow bg-transparent outline-none text-sm font-mono',
                                placeholder:  '0.00',
                                step:         '0.01',
                                min:          '0',
                                autocomplete: 'off'
                            }
                        }) }}
                    </label>

                    {% if form.value.vars.errors|length > 0 %}
                        <div class="flex gap-1.5 text-error text-xs items-center">
                            <twig:ux:icon name="lucide:info" class="h-3.5 w-3.5 shrink-0 mt-0.5"/>
                            <span>{{ form_errors(form.value) }}</span>
                        </div>
                    {% else %}
                        <p class="text-xs text-base-content/40">Enter the price in euros, e.g. 1.49</p>
                    {% endif %}
                </div>

                {# ── Shop / Store field ── #}
                <div class="flex flex-col gap-1.5">
                    {{ form_label(form.shop, 'Shop', {
                        label_attr: { class: 'text-sm font-medium text-base-content' }
                    }) }}

                    <label class="input input-bordered flex items-center gap-2
                                  {{ form.shop.vars.errors|length > 0 ? 'input-error' : '' }}">
                        <twig:ux:icon name="lucide:building" class="h-4 w-4 opacity-40 shrink-0"/>
                        {{ form_widget(form.shop, {
                            attr: {
                                class:        'grow bg-transparent outline-none text-sm',
                                placeholder:  'e.g. Continente, Pingo Doce, Lidl…',
                                autocomplete: 'off',
                                list:         'store-suggestions'
                            }
                        }) }}
                    </label>

                    <datalist id="store-suggestions">
                        <option value="Continente">
                        <option value="Pingo Doce">
                        <option value="Lidl">
                        <option value="Aldi">
                        <option value="Minipreço">
                        <option value="Intermarché">
                        <option value="El Corte Inglés">
                    </datalist>

                    {% if form.shop.vars.errors|length > 0 %}
                        <div class="flex gap-1.5 text-error text-xs items-center">
                            <twig:ux:icon name="lucide:info" class="h-3.5 w-3.5 shrink-0 mt-0.5"/>
                            <span>{{ form_errors(form.shop) }}</span>
                        </div>
                    {% else %}
                        <p class="text-xs text-base-content/40">Name of the store where you found this price.</p>
                    {% endif %}
                </div>

                {# ── Grocery product field ── #}
                <div class="flex flex-col gap-1.5">
                    {{ form_label(form.grocery, 'Grocery product', {
                        label_attr: { class: 'text-sm font-medium text-base-content' }
                    }) }}

                    <div class="relative">
                        {{ form_widget(form.grocery) }}
                    </div>

                    {% if form.grocery.vars.errors|length > 0 %}
                        <div class="flex gap-1.5 text-error text-xs items-center">
                            <twig:ux:icon name="lucide:info" class="h-3.5 w-3.5 shrink-0 mt-0.5"/>
                            <span>{{ form_errors(form.grocery) }}</span>
                        </div>
                    {% else %}
                        <p class="text-xs text-base-content/40">
                            The grocery item this price belongs to.
                        </p>
                    {% endif %}
                </div>

                {# ── Date field ── #}
                <div class="flex flex-col gap-1.5">
                    {{ form_label(form.createdAt, 'Date recorded', {
                        label_attr: { class: 'text-sm font-medium text-base-content' }
                    }) }}

                    <label class="input input-bordered flex items-center gap-2
                                  {{ form.createdAt.vars.errors|length > 0 ? 'input-error' : '' }}">
                        <twig:ux:icon name="lucide:calendar" class="h-4 w-4 opacity-40 shrink-0"/>
                        {{ form_widget(form.createdAt, {
                            attr: {
                                class: 'grow bg-transparent outline-none text-sm'
                            }
                        }) }}
                    </label>

                    {% if form.createdAt.vars.errors|length > 0 %}
                        <div class="flex gap-1.5 text-error text-xs items-center">
                            <twig:ux:icon name="lucide:info" class="h-3.5 w-3.5 shrink-0 mt-0.5"/>
                            <span>{{ form_errors(form.createdAt) }}</span>
                        </div>
                    {% else %}
                        <p class="text-xs text-base-content/40">The date when this price was recorded.</p>
                    {% endif %}
                </div>

                {# ── Global form errors ── #}
                {% if form.vars.errors|length > 0 %}
                    <div role="alert" class="alert alert-error alert-soft py-2.5">
                        <twig:ux:icon name="lucide:info" class="h-4 w-4 shrink-0"/>
                        <div class="text-sm">{{ form_errors(form) }}</div>
                    </div>
                {% endif %}

                {# ── Timestamp note ── #}
                <div class="flex items-center gap-2 text-xs text-base-content/40 bg-base-200 rounded-lg px-3 py-2.5">
                    <twig:ux:icon name="lucide:clock" class="h-3.5 w-3.5"/>
                    Recorded on <strong
                        class="font-medium text-base-content/60 ml-0.5">{{ price.createdAt|date("d M Y") }}</strong>
                </div>

                {# ── Actions ── #}
                <div class="flex flex-col sm:flex-row justify-end gap-2 pt-2 border-t border-base-300">
                    <button type="submit" class="btn btn-primary btn-sm sm:btn-md w-full sm:w-auto">
                        <twig:ux:icon name="lucide:circle-check" class="w-4 h-4"/>
                        Update price
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <p class="text-xs text-center text-base-content/30">
            You are editing a historical price record. You can view the full history on the
            <a href="{{ grocery is not null ? path('app_grocery_show', { id: grocery.id }) : path('app_index') }}"
               class="link link-hover">product profile</a>.
        </p>
    </div>
{% endblock %}
