{% extends 'base.html.twig' %}

{% block title %}Record Price{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,500;9..40,700&family=Fraunces:ital,wght@0,700;1,400&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --font-display: 'Fraunces', Georgia, serif;
            --font-body: 'DM Sans', system-ui, sans-serif;
        }

        html {
            font-family: var(--font-body);
        }

        .font-display {
            font-family: var(--font-display);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-base-200">

        {# ── TOPBAR ── #}
        <header class="bg-base-100 border-b border-base-300 sticky top-0 z-20">
            <div class="max-w-2xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-3">
                <div class="breadcrumbs text-sm py-0">
                    <ul>
                        <li><a href="{{ path('app_index') }}">Products</a></li>
                        {% if grocery is not null %}
                            <li><a href="{{ path('app_grocery_show', { id: grocery.id }) }}">{{ grocery.name }}</a></li>
                        {% endif %}
                        <li class="text-base-content/70">Record price</li>
                    </ul>
                </div>
            </div>
        </header>

        <div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 flex flex-col gap-5">

            {# ── Flash messages ── #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div role="alert"
                         class="alert alert-{{ label == 'error' ? 'error' : (label == 'warning' ? 'warning' : 'success') }}
                    alert-soft alert-horizontal">
                        {% if label == 'success' %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        {% elseif label == 'error' %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        {% endif %}
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            {# ── CONTEXT CARD (shown when a product is pre-selected) ── #}
            {% if grocery is not null %}
                <a href="{{ path('app_grocery_show', { id: grocery.id }) }}" class="card bg-base-100 hover:bg-base-200 shadow-sm">
                    <div class="card-body p-4 flex flex-row items-center gap-4">
                        <div
                            class="w-11 h-11 rounded-xl bg-base-200 flex items-center justify-center text-2xl shrink-0 select-none">
                            {{ grocery.emoji ?? '🛒' }}
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-base-content truncate">{{ grocery.name }}</p>
                            <p class="text-xs text-base-content/50 mt-0.5">
                                <span class="badge badge-ghost badge-xs align-middle">{{ grocery.type.label }}</span>
                            </p>
                        </div>
                    </div>
                </a>
            {% endif %}

            {# ── FORM CARD ── #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-5 sm:p-8 gap-6">

                    {# Card header #}
                    <div class="flex items-center gap-3 pb-4 border-b border-base-300">
                        <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div>
                            <h1 class="font-display text-xl text-base-content leading-tight">Record a price</h1>
                            <p class="text-xs text-base-content/50 mt-0.5">Log the current price of a product at a
                                specific store.</p>
                        </div>
                    </div>

                    {# ── Symfony form ── #}
                    {{ form_start(form, { attr: { class: 'flex flex-col gap-5'}}) }}

                    {# ── Value / Price field ── #}
                    <div class="flex flex-col gap-1.5">
                        {{ form_label(form.value, 'Price value', {
                            label_attr: { class: 'text-sm font-medium text-base-content' }
                        }) }}

                        <label class="input input-bordered flex items-center gap-2
                          {{ form.value.vars.errors|length > 0 ? 'input-error' : '' }}">

                            {# Euro symbol prefix #}
                            <span class="text-base-content/40 font-semibold text-sm shrink-0">€</span>

                            {{ form_widget(form.value, {
                                attr: {
                                    class:       'grow bg-transparent outline-none text-sm font-mono',
                                    placeholder: '0.00',
                                    step:        '0.01',
                                    min:         '0',
                                    autocomplete: 'off'
                                }
                            }) }}
                        </label>

                        {% if form.value.vars.errors|length > 0 %}
                            <div class="flex items-start gap-1.5 text-error text-xs">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 mt-0.5"
                                     viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                          clip-rule="evenodd"/>
                                </svg>
                                <span>{{ form_errors(form.value) }}</span>
                            </div>
                        {% else %}
                            <p class="text-xs text-base-content/40">Enter the price in euros, e.g. 1.49</p>
                        {% endif %}
                    </div>

                    {# ── Shop / Store field ── #}
                    <div class="flex flex-col gap-1.5">
                        {{ form_label(form.shop, 'Store / shop', {
                            label_attr: { class: 'text-sm font-medium text-base-content' }
                        }) }}

                        <label class="input input-bordered flex items-center gap-2
                          {{ form.shop.vars.errors|length > 0 ? 'input-error' : '' }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-40 shrink-0"
                                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                            </svg>
                            {{ form_widget(form.shop, {
                                attr: {
                                    class:       'grow bg-transparent outline-none text-sm',
                                    placeholder: 'e.g. Continente, Pingo Doce, Lidl…',
                                    autocomplete: 'off',
                                    list:         'store-suggestions'
                                }
                            }) }}
                        </label>

                        {% if form.shop.vars.errors|length > 0 %}
                            <div class="flex items-start gap-1.5 text-error text-xs">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 mt-0.5"
                                     viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                          clip-rule="evenodd"/>
                                </svg>
                                <span>{{ form_errors(form.shop) }}</span>
                            </div>
                        {% else %}
                            <p class="text-xs text-base-content/40">Name of the store where you found this price.</p>
                        {% endif %}
                    </div>

                    {# ── Grocery product field ── #}
                    <div class="flex flex-col gap-1.5">
                        {{ form_label(form.grocery, 'Grocery product', {
                            label_attr: { class: 'text-sm font-medium text-base-content' }
                        }) }}

                        <div class="relative flex items-center gap-2">
                            <div class="grow relative">
                                <div class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-40"
                                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 9m5-9v9m4-9v9m5-9l2 9"/>
                                    </svg>
                                </div>
                                {{ form_widget(form.grocery, {
                                    attr: {
                                        class: 'select select-bordered w-full text-sm pl-9'
                                        ~ (form.grocery.vars.errors|length > 0 ? ' select-error' : '')
                                    }
                                }) }}
                            </div>
                        </div>

                        {% if form.grocery.vars.errors|length > 0 %}
                            <div class="flex items-start gap-1.5 text-error text-xs">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0 mt-0.5"
                                     viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd"
                                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                          clip-rule="evenodd"/>
                                </svg>
                                <span>{{ form_errors(form.grocery) }}</span>
                            </div>
                        {% else %}
                            <p class="text-xs text-base-content/40">
                                The grocery item this price belongs to.
                                Can't find it?
                                <a href="{{ path('app_grocery_new') }}" class="link link-hover text-primary">Add a new
                                    product ↗</a>
                            </p>
                        {% endif %}
                    </div>

                    {# ── Timestamp note ── #}
                    <div
                        class="flex items-center gap-2 text-xs text-base-content/40 bg-base-200 rounded-lg px-3 py-2.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Recorded at <strong
                            class="font-medium text-base-content/60 ml-0.5">{{ "now"|date("d M Y, H:i") }}</strong>
                    </div>

                    {# ── Global form errors ── #}
                    {% if form.vars.errors|length > 0 %}
                        <div role="alert" class="alert alert-error alert-soft py-2.5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                            <div class="text-sm">{{ form_errors(form) }}</div>
                        </div>
                    {% endif %}

                    {# ── Actions ── #}
                    <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 pt-2 border-t border-base-300">
                        <a href="{{ grocery is not null
                        ? path('app_grocery_show', { id: grocery.id })
                        : path('app_index') }}"
                           class="btn btn-ghost btn-sm">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Record price
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>

            {# ── Hint ── #}
            <p class="text-xs text-center text-base-content/30">
                Prices are timestamped automatically. You can view the full history on the
                <a href="{{ grocery is not null ? path('app_grocery_show', { id: grocery.id }) : path('app_index') }}"
                   class="link link-hover">product profile</a>.
            </p>

        </div>
    </div>
{% endblock %}
