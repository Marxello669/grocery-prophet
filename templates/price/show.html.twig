{% extends 'base.html.twig' %}

{% block title %}Price{% endblock %}

{% block body %}
    <h1>Price</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ price.id }}</td>
            </tr>
            <tr>
                <th>Value</th>
                <td>{{ price.value }}</td>
            </tr>
            <tr>
                <th>Shop</th>
                <td>{{ price.shop }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ price.createdAt ? price.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_price_index') }}">back to list</a>

    <a href="{{ path('app_price_edit', {'id': price.id}) }}">edit</a>

    {{ include('price/_delete_form.html.twig') }}
{% endblock %}
