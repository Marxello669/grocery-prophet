<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Grocery Products{% endblock %} · Grocery</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛒</text></svg>">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,500;9..40,700&family=Fraunces:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
        <style>
            :root { --font-display: 'Fraunces', Georgia, serif; --font-body: 'DM Sans', system-ui, sans-serif; }
            html  { font-family: var(--font-body); }
            .font-display { font-family: var(--font-display); }
        </style>
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>

<body class="min-h-screen bg-base-200">

<div class="drawer lg:drawer-open">
    <input id="main-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content flex flex-col min-h-screen">
        <header class="bg-base-100 border-b border-base-300 sticky top-0 z-30 h-14 flex items-center px-4 gap-3">
            <label for="main-drawer" class="btn btn-ghost btn-square btn-sm lg:hidden" aria-label="Open sidebar">
                <twig:ux:icon name="lucide:menu" />
            </label>

            {# Page title / breadcrumb — child templates fill this block #}
            <div class="flex-1 min-w-0">
                {% block page_header %}
                    {# Default: just the app name on pages that don't define this block #}
                    <span class="font-display text-lg text-base-content">Grocery</span>
                {% endblock %}
            </div>

            {# Right-side topbar actions — child templates fill this block #}
            <div class="flex items-center gap-2 shrink-0">
                {% block topbar_actions %}{% endblock %}
            </div>

        </header>

        {# ── FLASH MESSAGES (global, rendered as toast notifications above content) ── #}
        <div class="toast toast-top toast-center z-50 p-4 pt-16 pointer-events-none">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div role="alert"
                         data-controller="flash"
                         class="alert alert-soft shadow-lg pointer-events-auto mb-2 min-w-[20rem] alert-success">
                        {% if label == 'success' %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        {% elseif label == 'error' %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        {% endif %}
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {# ── PAGE BODY ── #}
        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>

    </div>{# /drawer-content #}

    {# ── SIDEBAR ── #}
    <div class="drawer-side z-40">
        <label for="main-drawer" aria-label="Close sidebar" class="drawer-overlay"></label>

        <aside class="w-64 min-h-full bg-base-100 border-r border-base-300 flex flex-col">

            {# Logo #}
            <div class="h-14 flex items-center gap-2.5 px-5 border-b border-base-300 shrink-0">
                <div class="w-7 h-7 rounded-lg bg-primary flex items-center justify-center shrink-0">
                    <twig:ux:icon class="text-white" name="lucide:shopping-cart"/>
                </div>
                <span class="font-display text-lg text-base-content leading-none">Grocery</span>
            </div>

            {# Nav #}
            <nav class="flex-1 overflow-y-auto p-3">
                <ul class="menu menu-md w-full p-0 gap-1">

                    {# Helper macro — sets `active` class when the route matches #}
                    {% set _route = app.request.attributes.get('_route') %}

                    <li class="menu-title text-sm mt-2">Catalogue</li>

                    <li>
                        <a href="{{ path('app_index') }}"
                           class="{{ _route == 'app_index' or _route starts with 'app_grocery_show' or _route starts with 'app_grocery_edit' ? 'active' : '' }}">
                            <twig:ux:icon name="lucide:square-menu" />
                            Products
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_shopping_list_index') }}"
                           class="{{ _route == 'app_shopping_list_index' ? 'active' : '' }}">
                            <twig:ux:icon name="lucide:shopping-cart"/>
                            Shopping List
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_price_index') }}"
                           class="{{ _route == 'app_price_index' ? 'active' : '' }}">
                            <twig:ux:icon name="lucide:chart-line" />
                            Price history
                        </a>
                    </li>

                    <li class="menu-title text-sm mt-4">Manage</li>

                    <li>
                        <a href="{{ path('app_grocery_new') }}"
                           class="{{ _route == 'app_grocery_new' ? 'active' : '' }}">
                            <twig:ux:icon name="lucide:plus" />
                            Add product
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_price_new') }}"
                           class="{{ _route == 'app_price_new' or _route == 'app_price_edit' ? 'active' : '' }}">
                            <twig:ux:icon name="lucide:badge-euro" />
                            Record price
                        </a>
                    </li>

                </ul>
            </nav>

            {# Sidebar footer — theme toggle #}
            <div class="p-3 border-t border-base-300 shrink-0">
                <label class="flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-base-200
                              cursor-pointer transition-colors text-sm text-base-content/60 select-none">
                    <input type="checkbox" id="theme-toggle" class="hidden" />
                    <span class="swap swap-rotate">
                        <twig:ux:icon id="icon-moon" name="lucide:moon" />
                        <twig:ux:icon id="icon-sun" name="lucide:sun" />
                    </span>
                    <span id="theme-label">Dark mode</span>
                </label>
            </div>

        </aside>
    </div>

</div>

<script>
    (function () {
        const toggle = document.getElementById('theme-toggle');
        const label  = document.getElementById('theme-label');
        const moon   = document.getElementById('icon-moon');
        const sun    = document.getElementById('icon-sun');
        const html   = document.documentElement;

        function applyTheme(dark) {
            html.setAttribute('data-theme', dark ? 'dark' : 'light');
            toggle.checked = dark;
            label.textContent = dark ? 'Light mode' : 'Dark mode';
            moon.classList.toggle('hidden', dark);
            sun.classList.toggle('hidden', !dark);
        }

        applyTheme(localStorage.getItem('theme') === 'dark');

        toggle.addEventListener('change', function () {
            localStorage.setItem('theme', this.checked ? 'dark' : 'light');
            applyTheme(this.checked);
        });
    })();
</script>

</body>
</html>
