<li class="product-card">
    <div class="grid grid-cols-1 md:grid-cols-[2.5rem_1fr_12rem_10rem_6rem_9rem_1rem] gap-3 md:gap-x-4 md:items-center
                      px-4 py-4 md:px-5 md:py-3.5 border-b border-base-200 group cursor-default">

        <div class="flex items-center gap-3 md:contents">
            {# Emoji #}
            <div
                class="w-10 h-10 md:w-auto md:h-auto rounded-lg bg-base-200 flex items-center justify-center md:bg-transparent">
                <span class="text-2xl leading-none select-none" aria-hidden="true">{{ entry.type.emoji }}</span>
            </div>

            {# Name #}
            <div class="flex-1 min-w-0">
                <a href="{{ path('app_grocery_show', {id: entry.id}) }}"
                   class="hover:underline text-sm font-semibold text-base-content leading-tight block md:truncate">
                    {{ entry.name }}
                </a>
                {# Mobile only: Type badge and base product #}
                <div class="md:hidden mt-0.5 flex gap-1.5">
                    <span class="badge badge-ghost badge-xs">{{ entry.type.label }}</span>
                    {% if entry.baseProduct %}
                        <a href="{{ path('app_base_product_show', {id: entry.baseProduct.id}) }}" class="hover:underline badge badge-accent badge-xs">{{ entry.baseProduct.name }}</a>
                    {% endif %}
                </div>
            </div>

            {# Mobile only: Add price button #}
            <div class="md:hidden flex flex-row justify-start gap-2">
                <form method="post" action="{{ path('app_shopping_list_add', {id: entry.id}) }}">
                    <button type="submit"
                            class="btn btn-secondary btn-sm btn-circle">
                        <twig:ux:icon name="lucide:shopping-cart"/>
                    </button>
                </form>

                <a href="{{ path('app_price_new', {grocery: entry.id}) }}"
                   class="btn btn-primary btn-sm btn-circle">
                    <twig:ux:icon name="lucide:plus"/>
                </a>
            </div>
        </div>

        {# Desktop Type #}
        <span class="hidden md:inline badge badge-ghost badge-sm">{{ entry.type.label }}</span>

        {# Desktop Base Product #}
        <div class="hidden md:block">
            {% if entry.baseProduct %}
                <a href="{{ path('app_base_product_show', {id: entry.baseProduct.id}) }}"
                   class="badge badge-accent badge-sm hover:badge-accent-focus hover:underline">
                    {{ entry.baseProduct.name }}
                </a>
            {% else %}
                <span class="text-sm text-base-content/40">-</span>
            {% endif %}
        </div>

        {# Price #}
        <div class="flex justify-between items-center md:justify-end md:text-right md:whitespace-nowrap">
            <span class="md:hidden text-xs text-base-content/40 font-medium uppercase tracking-wider">Best Price</span>
            <span class="font-display text-base font-bold text-primary md:truncate">
                {{ lowestPrice ? (lowestPrice.value|number_format(2, ',', '.')) ~ '€'  : '-' }}
                <span class="text-xs font-normal text-base-content/50">/ {{ entry.unit.label }}</span>
            </span>
        </div>

        {# Shop #}
        <div class="flex justify-between items-center md:block md:whitespace-nowrap">
            <span class="md:hidden text-xs text-base-content/40 font-medium uppercase tracking-wider">Store</span>
            {% if lowestPrice %}
                <span class="badge badge-ghost badge-sm md:truncate">
                    {{ lowestPrice.shop.label }}
                </span>
            {% else %}
                <span class="text-sm">-</span>
            {% endif %}
        </div>

        {# Desktop Action #}
        <div class="hidden md:flex justify-end gap-1">
            <form method="post" action="{{ path('app_shopping_list_add', {id: entry.id}) }}">
                <button type="submit"
                   class="btn btn-secondary btn-sm btn-square">
                    <twig:ux:icon name="lucide:shopping-cart"/>
                </button>
            </form>
            <a href="{{ path('app_price_new', {grocery: entry.id}) }}"
               class="btn btn-primary btn-sm btn-square">
                <twig:ux:icon name="lucide:plus"/>
            </a>
        </div>
    </div>
</li>
