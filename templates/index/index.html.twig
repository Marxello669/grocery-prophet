{% extends 'base.html.twig' %}

{% block title %}Groceries{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Google Font: DM Sans (body) + Fraunces (display) #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,500;0,9..40,700;1,9..40,300&family=Fraunces:ital,wght@0,700;1,400&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --font-display: 'Fraunces', Georgia, serif;
            --font-body: 'DM Sans', system-ui, sans-serif;
        }

        html {
            font-family: var(--font-body);
        }

        .font-display {
            font-family: var(--font-display);
        }

        /* row reveal animation */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateX(-6px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .product-card {
            animation: fadeIn 0.22s ease both;
        }

        {% for i in 1..24 %}.product-card:nth-child({{ i }}) {
            animation-delay: {{ (i - 1) * 0.03 }}s;
        }

        {% endfor %}

        /* row hover */
        .product-card {
            transition: background .15s;
        }

        .product-card:hover {
            background-color: oklch(var(--color-base-200));
        }

        /* hide filtered rows */
        .product-card.hidden {
            display: none !important;
        }
    </style>
{% endblock %}

{% block body %}
    {# ── PAGE SHELL ── #}
    <div class="min-h-screen bg-base-200">

        {# ── HEADER ── #}
        <header class="bg-base-100 border-b border-base-300 sticky top-0 z-20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
                <div>
                    <h1 class="font-display text-2xl sm:text-3xl text-base-content leading-none">
                        Grocery <em class="not-italic text-primary">Products</em>
                    </h1>
                    <p class="text-xs text-base-content/50 mt-0.5 hidden sm:block">Browse and filter your full product
                        catalogue</p>
                </div>
                <div class="flex items-center gap-2">
        <span id="result-count" class="badge badge-ghost badge-lg font-mono text-base-content/60">
          {{ groceries|length }} items
        </span>
                    {# Trigger — opens the grocery modal #}
                    <label for="grocery-modal" class="btn btn-primary btn-sm cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        <span class="hidden sm:inline">Add product</span>
                    </label>

                    <a href="{{ path('app_price_new') }}" class="btn btn-primary btn-sm sm:flex">Add Price Record</a>
                </div>
            </div>
        </header>

        {# ── MODAL (rendered once, outside the content flow) ── #}
        {% include 'grocery/new.html.twig' with {
            form:       grocery_form,
            open_modal: open_modal ?? false
        } %}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 flex flex-col gap-6">
            {# ── FILTER PANEL ── #}
            <section class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-5 flex flex-col gap-4">

                    {# Row 1: name search + type select #}
                    <div class="flex flex-col sm:flex-row gap-3">

                        {# Name search #}
                        <label class="input input-bordered flex items-center gap-2 flex-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-40 shrink-0" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                            </svg>
                            <input
                                id="filter-name"
                                type="text"
                                placeholder="Search by name…"
                                class="grow text-sm"
                                autocomplete="off"
                            />
                        </label>

                        {# Type select #}
                        <select id="filter-type" class="select select-bordered w-full sm:w-52 text-sm">
                            <option value="">All types</option>
                            {% for type in types|sort %}
                                <option value="{{ type.value }}">{{ type.label }}</option>
                            {% endfor %}
                        </select>

                        {# Reset button #}
                        <button id="filter-reset"
                                class="btn btn-ghost btn-outline btn-sm self-center sm:self-auto whitespace-nowrap">
                            ↺ Reset
                        </button>

                    </div>
                </div>
            </section>

            {# ── ACTIVE FILTER SUMMARY ── #}
            <div id="active-filters" class="hidden flex-wrap gap-2 items-center text-sm text-base-content/60">
                <span class="font-medium">Active filters:</span>
                <span id="af-name" class="badge badge-primary badge-soft hidden"></span>
                <span id="af-type" class="badge badge-secondary badge-soft hidden"></span>
            </div>

            {# ── PRODUCT LIST ── #}
            <section class="card bg-base-100 shadow-sm overflow-hidden">

                {# Table header #}
                <div class="hidden sm:grid grid-cols-[2.5rem_1fr_9rem_6rem_2rem] gap-x-4 items-center
                  px-5 py-3 border-b border-base-300 text-xs font-semibold uppercase tracking-wider
                  text-base-content/40 select-none">
                    <span></span>
                    <span>Product</span>
                    <span>Type</span>
                    <span class="text-right">Price</span>
                    <span class="text-right"></span>
                </div>

                {# Rows #}
                <ul class="w-full flex flex-col">
                    {% for product in groceries %}
                        <li href="{{ path('app_grocery_show', {id: product.id}) }}"
                            class="product-card"
                            data-name="{{ product.name|lower }}"
                            data-type="{{ product.type.value }}"
                        >
                            <div class="grid grid-cols-[2.5rem_1fr_9rem_6rem_2rem] gap-x-4 items-center
                      px-5 py-3.5 border-b border-base-200 group cursor-default">

                                {# Emoji #}
                                <span class="text-2xl leading-none select-none" aria-hidden="true"> - </span>

                                {# Name #}
                                <div>
                                    <a href="{{ path('app_grocery_show', {id: product.id}) }}"
                                       class="hover:underline text-sm font-semibold text-base-content leading-tight">{{ product.name }}</a>
                                </div>

                                {# Type #}
                                <span class="badge badge-ghost badge-sm">{{ product.type.label }}</span>

                                {# Price #}
                                <span class="font-display text-base font-bold text-primary text-right">-€</span>

                                <a href="{{ path('app_price_new', {grocery: product.id}) }}" class="btn btn-primary btn-sm sm:flex">+</a>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                {# Empty state #}
                <div id="empty-state" class="hidden flex-col items-center justify-center py-20 text-center gap-3">
                    <span class="text-5xl">🔍</span>
                    <p class="font-display text-xl text-base-content/60">No products found</p>
                    <p class="text-sm text-base-content/40">Try adjusting your filters</p>
                    <button id="empty-reset" class="btn btn-ghost btn-sm mt-2">↺ Clear filters</button>
                </div>

                {# List footer with count #}
                <div id="list-footer"
                     class="px-5 py-3 flex items-center justify-between text-xs text-base-content/40 border-t border-base-200">
                    <span id="footer-count">{{ groceries|length }} products</span>
                    <span>Sorted by name</span>
                </div>

            </section>
        </div>
    </div>

    {# ── FILTER LOGIC ── #}
    <script>
        (function () {
            const nameInput = document.getElementById('filter-name');
            const typeSelect = document.getElementById('filter-type');
            const resetBtn = document.getElementById('filter-reset');
            const emptyReset = document.getElementById('empty-reset');
            const cards = document.querySelectorAll('.product-card');
            const countEl = document.getElementById('result-count');
            const emptyEl = document.getElementById('empty-state');
            const gridEl = document.getElementById('product-grid');
            const listFooter = document.getElementById('list-footer');
            const footerCount = document.getElementById('footer-count');
            const afPanel = document.getElementById('active-filters');
            const afName = document.getElementById('af-name');
            const afType = document.getElementById('af-type');

            nameInput.addEventListener('input', applyFilters);
            typeSelect.addEventListener('change', applyFilters);
            resetBtn.addEventListener('click', resetFilters);
            emptyReset.addEventListener('click', resetFilters);

            function applyFilters() {
                const nameVal = nameInput.value.trim().toLowerCase();
                const typeVal = typeSelect.value;

                let visible = 0;

                cards.forEach(card => {
                    const matchName = !nameVal || card.dataset.name.includes(nameVal);
                    const matchType = !typeVal || card.dataset.type === typeVal;

                    if (matchName && matchType) {
                        card.classList.remove('hidden');
                        visible++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                // Count + footer
                countEl.textContent = visible + ' item' + (visible !== 1 ? 's' : '');
                footerCount.textContent = visible + ' product' + (visible !== 1 ? 's' : '');

                // Empty state
                if (visible === 0) {
                    gridEl.style.display = 'none';
                    listFooter.style.display = 'none';
                    emptyEl.classList.remove('hidden');
                    emptyEl.style.display = 'flex';
                } else {
                    gridEl.style.display = '';
                    listFooter.style.display = '';
                    emptyEl.classList.add('hidden');
                    emptyEl.style.display = '';
                }
            }

            function updateActiveFilters(name, type) {
                const any = name || type;
                afPanel.style.display = any ? 'flex' : 'none';

                if (name) {
                    afName.textContent = '🔤 ' + name;
                    afName.classList.remove('hidden');
                } else {
                    afName.classList.add('hidden');
                }
                if (type) {
                    afType.textContent = '📦 ' + type;
                    afType.classList.remove('hidden');
                } else {
                    afType.classList.add('hidden');
                }
            }

            function resetFilters() {
                nameInput.value = '';
                typeSelect.value = '';
                applyFilters();
            }

        })();
    </script>
{% endblock %}
