{% extends 'base.html.twig' %}

{% block title %}Add Product{% endblock %}

{% block page_header %}
    <div class="breadcrumbs text-sm py-0">
        <ul>
            <li class="text-base-content/70">Groceries</li>
        </ul>
    </div>
{% endblock %}

{% block body %}
    {# ── MODAL (rendered once, outside the content flow) ── #}
    {% include 'grocery/modal.html.twig' with {
        form:       grocery_form,
        open_modal: open_modal ?? false
    } %}

    <twig:GroceryTable/>

    {# Todo: REMOVE THIS #}
    <script>
        (function () {
            const nameInput = document.getElementById('filter-name');
            const typeSelect = document.getElementById('filter-type');
            const resetBtn = document.getElementById('filter-reset');
            const emptyReset = document.getElementById('empty-reset');
            const cards = document.querySelectorAll('.product-card');
            const countEl = document.getElementById('result-count');
            const emptyEl = document.getElementById('empty-state');
            const gridEl = document.getElementById('product-grid');
            const listFooter = document.getElementById('list-footer');
            const footerCount = document.getElementById('footer-count');
            const afPanel = document.getElementById('active-filters');
            const afName = document.getElementById('af-name');
            const afType = document.getElementById('af-type');

            nameInput.addEventListener('input', applyFilters);
            typeSelect.addEventListener('change', applyFilters);
            resetBtn.addEventListener('click', resetFilters);
            emptyReset.addEventListener('click', resetFilters);

            function applyFilters() {
                const nameVal = nameInput.value.trim().toLowerCase();
                const typeVal = typeSelect.value;

                let visible = 0;

                cards.forEach(card => {
                    const matchName = !nameVal || card.dataset.name.includes(nameVal);
                    const matchType = !typeVal || card.dataset.type === typeVal;

                    if (matchName && matchType) {
                        card.classList.remove('hidden');
                        visible++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                // Count + footer
                countEl.textContent = visible + ' item' + (visible !== 1 ? 's' : '');
                footerCount.textContent = visible + ' product' + (visible !== 1 ? 's' : '');

                // Empty state
                if (visible === 0) {
                    gridEl.style.display = 'none';
                    listFooter.style.display = 'none';
                    emptyEl.classList.remove('hidden');
                    emptyEl.style.display = 'flex';
                } else {
                    gridEl.style.display = '';
                    listFooter.style.display = '';
                    emptyEl.classList.add('hidden');
                    emptyEl.style.display = '';
                }
            }

            function updateActiveFilters(name, type) {
                const any = name || type;
                afPanel.style.display = any ? 'flex' : 'none';

                if (name) {
                    afName.textContent = '🔤 ' + name;
                    afName.classList.remove('hidden');
                } else {
                    afName.classList.add('hidden');
                }
                if (type) {
                    afType.textContent = '📦 ' + type;
                    afType.classList.remove('hidden');
                } else {
                    afType.classList.add('hidden');
                }
            }

            function resetFilters() {
                nameInput.value = '';
                typeSelect.value = '';
                applyFilters();
            }

        })();
    </script>
{% endblock %}
