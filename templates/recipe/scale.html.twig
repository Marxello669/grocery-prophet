{% extends 'base.html.twig' %}

{% block title %}Scale Recipe: {{ recipe.name }}{% endblock %}

{% block page_header %}
    <div class="breadcrumbs text-sm py-0">
        <ul>
            <li><a href="{{ path('app_recipe_index') }}">Recipes</a></li>
            <li><a href="{{ path('app_recipe_show', {'id': recipe.id}) }}">{{ recipe.name }}</a></li>
            <li class="text-base-content/70">Scale Recipe</li>
        </ul>
    </div>
{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 flex flex-col gap-6">

        {# ── HEADER CARD ── #}
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-4 sm:p-8 gap-6">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                        <twig:ux:icon name="lucide:maximize-2" class="h-6 w-6 text-primary" />
                    </div>
                    <div>
                        <h1 class="font-display text-2xl sm:text-3xl text-base-content leading-tight">
                            {{ recipe.name }}
                        </h1>
                        <p class="text-sm text-base-content/60 mt-2">Adjust quantities and see how your costs change</p>
                    </div>
                </div>
            </div>
        </div>

        {# ── SCALING CONTROLS ── #}
        <div class="card bg-base-100 shadow-sm overflow-hidden">
            <div class="card-body p-4 sm:p-8 gap-4 border-b border-base-300">
                <h2 class="font-display text-lg text-base-content flex items-center gap-2">
                    <twig:ux:icon name="lucide:sliders" class="h-5 w-5 text-primary" />
                    Choose Scaling Factor
                </h2>
                <p class="text-sm text-base-content/50">Click a preset or enter a custom value</p>
            </div>
            <div class="card-body p-4 sm:p-8 gap-6">

                {# Quick Preset Buttons #}
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3">
                    <a href="{{ path('app_recipe_scale', {'id': recipe.id, 'factor': 0.5}) }}" 
                       class="btn {% if factor == 0.5 %}btn-primary btn-active{% else %}btn-outline{% endif %} h-auto py-3 flex flex-col items-center gap-1">
                        <twig:ux:icon name="lucide:minus" class="h-5 w-5" />
                        <span class="text-xs font-bold">÷ 2</span>
                        <span class="text-xs opacity-70">Half</span>
                    </a>
                    <a href="{{ path('app_recipe_scale', {'id': recipe.id, 'factor': 1}) }}" 
                       class="btn {% if factor == 1 %}btn-primary btn-active{% else %}btn-outline{% endif %} h-auto py-3 flex flex-col items-center gap-1">
                        <twig:ux:icon name="lucide:check" class="h-5 w-5" />
                        <span class="text-xs font-bold">× 1</span>
                        <span class="text-xs opacity-70">Original</span>
                    </a>
                    <a href="{{ path('app_recipe_scale', {'id': recipe.id, 'factor': 1.5}) }}" 
                       class="btn {% if factor == 1.5 %}btn-primary btn-active{% else %}btn-outline{% endif %} h-auto py-3 flex flex-col items-center gap-1">
                        <twig:ux:icon name="lucide:plus" class="h-5 w-5" />
                        <span class="text-xs font-bold">× 1.5</span>
                        <span class="text-xs opacity-70">1.5x</span>
                    </a>
                    <a href="{{ path('app_recipe_scale', {'id': recipe.id, 'factor': 2}) }}" 
                       class="btn {% if factor == 2 %}btn-primary btn-active{% else %}btn-outline{% endif %} h-auto py-3 flex flex-col items-center gap-1">
                        <twig:ux:icon name="lucide:plus" class="h-5 w-5" />
                        <span class="text-xs font-bold">× 2</span>
                        <span class="text-xs opacity-70">Double</span>
                    </a>
                </div>

                <div class="divider my-0"></div>
                
                <div class="space-y-3">
                    <label class="label">
                        <span class="label-text text-sm font-medium">Custom Factor</span>
                        <span class="label-text-alt text-xs text-base-content/50">(0.5 - 10)</span>
                    </label>
                    <div class="flex gap-2">
                        <input type="number" min="0.5" max="10" step="0.5" value="{{ factor }}" 
                               id="customFactor" placeholder="2.5" 
                               class="input input-bordered input-primary flex-1" 
                               onkeypress="if(event.key === 'Enter') goToScale()" />
                        <button onclick="goToScale()" class="btn btn-primary gap-2">
                            <twig:ux:icon name="lucide:send" class="h-4 w-4" />
                            Apply
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# ── STATS CARDS ── #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
            {# Servings Comparison #}
            {% if recipe.servings %}
                <div class="card bg-base-100 shadow-sm">
                    <div class="card-body p-4 sm:p-8 gap-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs text-base-content/50 uppercase tracking-widest font-bold">Servings</p>
                            </div>
                            <div class="badge badge-info gap-2">
                                <twig:ux:icon name="lucide:users" class="h-3 w-3" />
                                {{ factor }}×
                            </div>
                        </div>
                        <div class="flex items-end gap-4 pt-2">
                            <div>
                                <p class="text-xs text-base-content/60 mb-1">Original</p>
                                <p class="text-3xl font-display font-bold text-base-content">{{ recipe.servings }}</p>
                            </div>
                            <div class="flex-1 flex justify-center">
                                <twig:ux:icon name="lucide:arrow-right" class="h-5 w-5 text-info" />
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-base-content/60 mb-1">Scaled</p>
                                <p class="text-3xl font-display font-bold text-info">{{ scaled_servings }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Cost Comparison #}
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body p-4 sm:p-8 gap-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs text-base-content/50 uppercase tracking-widest font-bold">Total Cost</p>
                        </div>
                        <div class="badge {% if scaled_cost < original_cost %}badge-success{% elseif scaled_cost > original_cost %}badge-warning{% else %}badge-ghost{% endif %} gap-2">
                            <twig:ux:icon name="lucide:euro" class="h-3 w-3" />
                            {% if scaled_cost < original_cost %}
                                Save {{ ((original_cost - scaled_cost)|number_format(2, ',', '.')) }}€
                            {% elseif scaled_cost > original_cost %}
                                +{{ ((scaled_cost - original_cost)|number_format(2, ',', '.')) }}€
                            {% else %}
                                Same cost
                            {% endif %}
                        </div>
                    </div>
                    <div class="flex items-end gap-4 pt-2">
                        <div>
                            <p class="text-xs text-base-content/60 mb-1">Original</p>
                            <p class="text-3xl font-display font-bold text-base-content">{{ (original_cost|number_format(2, ',', '.')) }}€</p>
                        </div>
                        <div class="flex-1 flex justify-center">
                            <twig:ux:icon name="lucide:arrow-right" class="h-5 w-5 text-success" />
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-base-content/60 mb-1">Scaled</p>
                            <p class="text-3xl font-display font-bold text-success">{{ (scaled_cost|number_format(2, ',', '.')) }}€</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── INGREDIENTS TABLE ── #}
        <div class="card bg-base-100 shadow-sm overflow-hidden">
            <div class="card-body p-4 sm:p-8 gap-4 border-b border-base-300">
                <h2 class="font-display text-lg text-base-content flex items-center gap-2">
                    <twig:ux:icon name="lucide:list" class="h-5 w-5 text-primary" />
                    Scaled Ingredients
                </h2>
            </div>
            <div class="overflow-x-auto">
                <table class="table table-compact sm:table-normal">
                    <thead class="bg-base-200/50">
                        <tr class="border-b-2 border-base-300">
                            <th class="text-base-content font-bold text-sm">Ingredient</th>
                            <th class="text-center text-base-content font-bold text-sm">Original</th>
                            <th class="text-center text-base-content font-bold text-sm">Price</th>
                            <th class="text-center text-base-content font-bold text-sm"></th>
                            <th class="text-center text-base-content font-bold text-sm">Scaled</th>
                            <th class="text-center text-base-content font-bold text-sm">Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in scaled_ingredients %}
                            <tr class="border-b border-base-200 hover:bg-base-200/40 transition-colors">
                                <td class="font-semibold text-base-content">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0">
                                            <twig:ux:icon name="lucide:leaf" class="h-4 w-4 text-primary" />
                                        </div>
                                        {{ item.original.baseProduct.name }}
                                    </div>
                                </td>
                                <td class="text-center text-base-content/80">
                                    <div class="font-mono text-sm">
                                        <span class="font-bold">{{ item.original.quantity }}</span>
                                        <span class="text-base-content/60 text-xs ml-1">{{ item.original.unit.label }}</span>
                                    </div>
                                </td>
                                <td class="text-center text-base-content/80">
                                    <div class="font-mono text-sm">
                                        {% if item.lowest_price > 0 %}
                                            <span class="font-semibold text-base-content">{{ (item.lowest_price|number_format(2, ',', '.')) }}€</span>
                                        {% else %}
                                            <span class="text-base-content/40 italic">—</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        {% if item.factor > 1 %}
                                            <span class="badge badge-success gap-1">
                                                <twig:ux:icon name="lucide:trending-up" class="h-3 w-3" />
                                                ×{{ item.factor }}
                                            </span>
                                        {% elseif item.factor < 1 %}
                                            <span class="badge badge-warning gap-1">
                                                <twig:ux:icon name="lucide:trending-down" class="h-3 w-3" />
                                                ÷{{ (1 / item.factor)|round(1) }}
                                            </span>
                                        {% else %}
                                            <span class="badge badge-ghost">
                                                <twig:ux:icon name="lucide:minus" class="h-3 w-3" />
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="font-mono font-bold text-sm text-primary bg-primary/5 rounded px-2 py-1">
                                        <span>{{ item.scaled_quantity }}</span>
                                        <span class="text-base-content/60 text-xs ml-1">{{ item.original.unit.label }}</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="font-mono text-sm">
                                        {% if item.scaled_price > 0 %}
                                            <span class="font-bold text-success bg-success/10 rounded px-2 py-1">{{ (item.scaled_price|number_format(2, ',', '.')) }}€</span>
                                        {% else %}
                                            <span class="text-base-content/40 italic">—</span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ── ACTION BUTTONS ── #}
        <div class="flex flex-col sm:flex-row gap-3 justify-center sm:justify-start pt-4">
            <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn btn-outline gap-2 flex-1 sm:flex-none">
                <twig:ux:icon name="lucide:arrow-left" class="h-4 w-4" />
                Back to Recipe
            </a>
            <a href="{{ path('app_recipe_index') }}" class="btn btn-ghost gap-2 flex-1 sm:flex-none">
                <twig:ux:icon name="lucide:list" class="h-4 w-4" />
                All Recipes
            </a>
        </div>

    </div>

    <script>
        function goToScale() {
            const factor = document.getElementById('customFactor').value;
            if (factor && factor >= 0.5 && factor <= 10) {
                window.location.href = `{{ path('app_recipe_scale', {'id': recipe.id, 'factor': '__FACTOR__'}) }}`.replace('__FACTOR__', factor);
            } else {
                const errorAlert = document.createElement('div');
                errorAlert.className = 'alert alert-error shadow-lg fixed bottom-4 right-4 max-w-sm';
                errorAlert.innerHTML = '<div><span>Please enter a value between 0.5 and 10</span></div>';
                document.body.appendChild(errorAlert);
                setTimeout(() => errorAlert.remove(), 3000);
            }
        }
    </script>
{% endblock %}
