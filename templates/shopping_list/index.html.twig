{% extends 'base.html.twig' %}

{% block title %}Shopping List & Optimal Plan{% endblock %}

{% block page_header %}
    <div class="breadcrumbs text-sm py-0">
        <ul>
            <li><a href="{{ path('app_index') }}">Products</a></li>
            <li class="text-base-content/70">Shopping List</li>
        </ul>
    </div>
{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col gap-8">

        <header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
            <div>
                <h1 class="text-3xl font-display font-bold">Shopping Plan</h1>
            </div>
            <div class="bg-primary text-primary-content px-4 py-2 rounded-lg shadow-lg text-right">
                <p class="text-[10px] uppercase font-black tracking-widest opacity-70">Optimal Total</p>
                <p class="text-xl font-display font-black">{{ totalOptimal|number_format(2) }}€</p>
            </div>
        </header>

        {% if items is empty %}
            <div class="card bg-base-100 shadow-sm border border-dashed border-base-300 p-20 text-center">
                <span class="text-6xl mb-4">🛒</span>
                <h2 class="text-xl font-bold">Your list is empty</h2>
                <p class="text-base-content/60 mb-6">Add some products to see your optimal shopping route.</p>
                <div class="card-actions justify-center">
                    <a href="{{ path('app_index') }}" class="btn btn-primary">Browse Products</a>
                </div>
            </div>
        {% else %}

            {# Identify unique stores in the optimal plan #}
            {% set uniqueStores = [] %}
            {% for plan in optimalPlan %}
                {% if plan.best_shop and plan.best_shop.label not in uniqueStores %}
                    {% set uniqueStores = uniqueStores|merge([plan.best_shop.label]) %}
                {% endif %}
            {% endfor %}

            <div class="flex flex-col gap-8">
                {% for storeLabel in uniqueStores %}
                    {% set storeItems = [] %}
                    {% set storeTotal = 0 %}
                    {% set storeColor = '#641ae6' %}

                    {% for plan in optimalPlan %}
                        {% if plan.best_shop and plan.best_shop.label == storeLabel %}
                            {% set storeItems = storeItems|merge([plan]) %}
                            {% set storeTotal = storeTotal + plan.total %}
                            {% set storeColor = plan.best_shop.color %}
                        {% endif %}
                    {% endfor %}

                    <section class="card bg-base-100 shadow-sm border border-base-200 overflow-hidden">
                        {# Store Header #}
                        <div class="px-5 py-4 border-b border-base-200 flex justify-between items-center"
                             style="background-color: {{ storeColor }}10">
                            <div class="flex items-center gap-3">
                                <span class="w-4 h-4 rounded-full" style="background-color: {{ storeColor }};"></span>
                                <h2 class="font-display text-lg font-bold">{{ storeLabel }}</h2>
                                <span class="badge badge-ghost badge-sm">{{ storeItems|length }} items</span>
                            </div>
                            <div class="text-right">
                                <span class="text-xs opacity-60 mr-2">Store Subtotal:</span>
                                <span class="font-bold">{{ storeTotal|number_format(2) }}€</span>
                            </div>
                        </div>

                        {# Items List #}
                        <ul class="divide-y divide-base-200">
                            {% for plan in storeItems %}
                                {% set item = plan.item %}
                                <li class="px-5 py-4 flex items-center gap-4 group hover:bg-base-200/20 transition-colors">

                                    <form action="{{ path('app_shopping_list_toggle_check', {id: item.id}) }}"
                                          method="post">
                                        <input type="checkbox"
                                               class="checkbox checkbox-md" {{ item.isChecked ? 'checked' : '' }}
                                               onchange="this.form.submit()">
                                    </form>

                                    <div class="flex-1 min-w-0">
                                        <h3 class="font-medium {{ item.isChecked ? 'line-through text-base-content/40' : '' }}">
                                            <a href="{{ path('app_grocery_show', {id: item.grocery.id}) }}"
                                               class="hover:underline">{{ item.grocery.name }}</a>
                                        </h3>
                                        <div class="flex items-center gap-2">
                                            <span
                                                class="text-xs text-base-content/50">{{ item.grocery.type.label }}</span>
                                            <span
                                                class="text-[10px] px-1 bg-base-200 rounded text-base-content/70">{{ plan.best_price|number_format(2) }}€/{{ item.grocery.unit.label }}</span>
                                        </div>
                                    </div>

                                    {# QUANTITY CONTROLS #}
                                    <div class="flex items-center gap-4">
                                        <form action="{{ path('app_shopping_list_update_quantity', {id: item.id}) }}"
                                              method="post"
                                              class="flex items-center gap-1 bg-base-200/50 rounded-lg p-1">
                                            <button name="quantity" value="{{ item.quantity - 1 }}"
                                                    class="btn btn-xs btn-ghost btn-square"
                                                    {% if item.quantity <= 1 %}disabled{% endif %}>-
                                            </button>
                                            <span class="text-sm font-bold w-6 text-center">{{ item.quantity }}</span>
                                            <button name="quantity" value="{{ item.quantity + 1 }}"
                                                    class="btn btn-xs btn-ghost btn-square">+
                                            </button>
                                        </form>

                                        <div class="w-16 text-right font-mono font-bold text-sm">
                                            {{ plan.total|number_format(2) }}€
                                        </div>

                                        {# REMOVE BUTTON #}
                                        <form action="{{ path('app_shopping_list_remove', {id: item.id}) }}"
                                              method="post"
                                              onsubmit="return confirm('Remove {{ item.grocery.name }} from list?')">
                                            <button type="submit"
                                                    class="btn btn-xs btn-ghost btn-square text-error opacity-0 group-hover:opacity-100 transition-opacity">
                                                <twig:ux:icon name="lucide:trash-2" class="h-4 w-4"/>
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endfor %}

                {# Handle items with no price data #}
                {% set unknownItems = optimalPlan|filter(p => p.best_shop is null) %}
                {% if unknownItems|length > 0 %}
                    <div class="collapse collapse-arrow bg-base-200/30 border border-base-300">
                        <input type="checkbox"/>
                        <div class="collapse-title text-sm font-medium text-base-content/50">
                            Items with no price data available ({{ unknownItems|length }})
                        </div>
                        <div class="collapse-content px-0">
                            <ul class="divide-y divide-base-200">
                                {% for plan in unknownItems %}
                                    <li class="px-5 py-3 flex justify-between items-center bg-base-100">
                                        <span class="text-sm">{{ plan.item.grocery.name }}</span>
                                        <form action="{{ path('app_shopping_list_remove', {id: plan.item.id}) }}"
                                              method="post">
                                            <button type="submit" class="btn btn-xs btn-link text-error no-underline">
                                                Remove
                                            </button>
                                        </form>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}
            </div>

            {# Store Savings Comparison Stats #}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
                {% for shopValue, data in shopTotals %}
                    <div class="card bg-base-100 shadow-sm border border-base-200">
                        <div class="p-4">
                            <div class="flex justify-between items-start mb-2">
                                <span class="badge badge-sm"
                                      style="background-color: {{ data.shop.color }}; border: none; color: white;">{{ data.shop.label }}</span>
                                {% if data.missing_items > 0 %}
                                    <span class="text-[9px] text-error uppercase font-bold">{{ data.missing_items }} missing</span>
                                {% endif %}
                            </div>
                            <p class="text-xl font-bold">{{ data.total|number_format(2) }}€</p>
                            {% set diff = data.total - totalOptimal %}
                            <p class="text-xs {{ diff > 0 ? 'text-error' : 'text-success' }}">
                                {{ diff > 0 ? '+' ~ diff|number_format(2) ~ '€ vs optimal' : 'Cheapest option' }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
